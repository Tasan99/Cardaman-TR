# Development only. Change both passwords; never commit .env.
# Model policy: development preserves the local launcher; server requires a trusted
# ModelScope and pinned qwen3:4b / qwen3:8b / bge-m3 roles. The single-operator workspace
# refuses server mode: this switch does not create company authentication or an API.
# Set in the process environment; existing local launchers do not read this from .env.
CARDAMAN_MODE=development
# Ollama itself must run with OLLAMA_NO_CLOUD=1 (or disable_ollama_cloud=true).
# Setting it only in Cardaman does not reconfigure an already-running Ollama daemon.
POSTGRES_PASSWORD=local-owner-change-me
APP_DB_PASSWORD=local-app-change-me
INGEST_DB_PASSWORD=local-ingest-change-me
EXTRACT_DB_PASSWORD=local-extract-change-me
DATABASE_URL=postgresql://regchain_app:local-app-change-me@db:5432/regchain
# Explicit provider selection; only local Ollama and the development rules baseline exist.
LLM_PROVIDER=
LLM_MODEL=
LLM_MODEL_DIGEST=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Seconds per provider call (10-3600). Raise it for a local model that spills to CPU.
LLM_TIMEOUT_SECONDS=
LLM_API_KEY=
EVM_RPC_URL=
EVM_CHAIN_ID=11155111
EVM_CONTRACT_ADDRESS=
# Reasoning models burn the generation budget on hidden thinking: on or off.
LLM_THINKING=
# Optional local embedding model for semantic policy search (pilot/workspace only).
# Company policy text is embedded, so only a local Ollama host is accepted.
# Empty: the launcher uses bge-m3:latest when installed, else word-overlap search.
EMBED_MODEL=
EMBED_MODEL_DIGEST=
# Optional separate model for the judgement stage: applicability, and every policy passage
# on its own (does it contradict the duty? does it require it?). Extraction keeps LLM_MODEL.
# Empty: the launcher uses qwen3:8b with thinking on when installed. With thinking on, the
# contradiction question and the confirmation of a favourable answer are reasoned; the first
# support question is put to the same model without reasoning.
# Compare candidates with scripts/judge_benchmark.py first.
JUDGE_MODEL=
JUDGE_MODEL_DIGEST=
JUDGE_THINKING=
JUDGE_TIMEOUT_SECONDS=
JUDGE_NUM_PREDICT=
# Decision mode and repeated judgement are chosen per run in the workspace form (04. adım),
# not here: 'human' (default) or 'autonomous', and 1-3 judge readings per passage.
# v0.16 — optional local cross-encoder reranker between RRF fusion and the judge (semantic
# search only). Runs in-process with sentence-transformers; policy text never leaves the machine.
# Empty: off, the fused (RRF) order is used. Weights come from the local Hugging Face cache;
# nothing is downloaded unless RERANK_ALLOW_DOWNLOAD=on (one-time, about 2.3 GB for the default).
# Server model mode always rejects RERANK_ALLOW_DOWNLOAD=on.
# Measured 23 September 2026 on CPU: 12 s to load from cache, under 1 s for 20 passages; it
# shrinks the judge window for large policy sets (12 -> 8 passages) and never acts as a gate.
RERANK_MODEL=
RERANK_ALLOW_DOWNLOAD=
RERANK_DEVICE=
# Optional similarity floor for the structural evidence gate (0-1). Off by default: a contradiction
# rarely shares the duty's words and was measured to rank low, so a floor would hide it.
EVIDENCE_MIN_SIMILARITY=
# Optional on-disk cache of model answers across runs (same model, prompt, payload and schema).
# Development only, off by default; scoped caches never share data across companies.
# Server mode rejects a configured disk cache until encrypted cache storage is implemented.
AI_CACHE_DIR=
# v0.18 (docs/PHASE18.md). Applicability when every deterministic gate is a CLEAR match (the company
# is on the regulation's own obliged-party list, the clause's parties match, no exemption wording):
# 'model' asks the reasoning judge (the v0.17 behaviour, code default), 'quick' asks it without
# reasoning, 'rule' decides APPLIES by rule with no model call. A rule mismatch never asks a model.
# Empty: the launcher uses 'rule'.
APPLICABILITY_CLEAR_MATCH=
# One unreasoned call per duty sets aside the policy passages about another measure before the
# reasoning judge reads the rest (the three best-ranked passages and control rows are always read).
# Empty: the launcher uses 'on'; the code default is off.
RELEVANCE_SCREEN=
# Context window of the judge (tokens). Empty: the launcher and the workspace server use 8192 when a judge
# model is set (qwen3:8b is then all on an 8 GB GPU; at 16384 a fifth of it ran on the CPU); the code default
# is 16384. JUDGE_NUM_CTX_LARGE (empty: 16384) is the wider window a narrower judge keeps beside it: the v18
# applicability question always uses it, and JUDGE_CTX_MODE=adaptive falls back to it (below).
JUDGE_NUM_CTX=
JUDGE_NUM_CTX_LARGE=
# v0.19. How each policy passage is judged for coverage: 'v18' (code default) asks the reasoning judge
# about every passage and confirms a contradiction on a second reading; 'v19' runs a keyword and quantity
# check and one unreasoned classification per passage, and asks the reasoning judge only when a conflict
# is possible or the answer is ambiguous. Empty: the launcher and the workspace server use 'v19'.
COVERAGE_PIPELINE=
# Judge window per call (v0.19): 'fixed' (code default) never goes above JUDGE_NUM_CTX; 'adaptive' keeps
# every call that fits JUDGE_NUM_CTX there, and only a prompt that is still too long after its evidence is
# compressed (fewer passages, shorter passages) goes to JUDGE_NUM_CTX_LARGE, as does one more try of a
# reasoning answer cut short at the smaller window. Needs JUDGE_NUM_CTX below JUDGE_NUM_CTX_LARGE.
# Empty: the workspace server uses 'adaptive' when a judge model is set (the code default stays 'fixed').
# Every model call records model, num_ctx, estimated tokens, window_action, times, tokens/second and the
# GPU/CPU split (ai-calls.jsonl beside the run).
JUDGE_CTX_MODE=
# Retired in v0.19 (per-duty small window); read by nothing, kept so an older .env still loads.
JUDGE_NUM_CTX_SMALL=
# Optional separate model for the fast work (relevance screen, fast classifier, summaries, drafts),
# pinned by digest like LLM_MODEL. Empty: the extraction model without thinking does it.
FAST_MODEL=
FAST_MODEL_DIGEST=
